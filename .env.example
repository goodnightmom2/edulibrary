# GEMINI_API_KEY: Optional for AI features if enabled later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where EduLibrary Cloud is hosted (used for sitemap, SEO canonical, CSRF origin).
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Dùng DATABASE_URL cho Neon/Supabase trên Vercel, hoặc các trường SQL_* cho Docker/Local)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/edulibrary?sslmode=require"
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="MY_POSTGRES_PASSWORD"
SQL_DB_NAME="edulibrary"

# Authentication & Security
JWT_SECRET="change-this-to-a-64-char-random-secret"
ADMIN_SEED_EMAIL="admin@edulibrary.vn"
ADMIN_SEED_PASSWORD="ChangeMe@Edu2026"
RUN_SAMPLE_SEED="false"

# Cloudflare R2 Object Storage (S3-compatible; leave blank for Local Modular Storage fallback)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="edulibrary-cloud"

# External Docker LibreOffice Document Worker (optional; in-process OMML/Office worker runs if blank)
WORKER_URL=""
WORKER_SHARED_SECRET="change-this-worker-shared-secret"

# Local Storage Fallback & Limits
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="25"
